    <script>
      (() => {
        const PRELOAD_SLOT = '__AI_HOME_FEED_PRELOAD__';
        if (window[PRELOAD_SLOT]?.promise) return;

        const trimTrailingSlash = (value) => String(value || '').replace(/\/+$/, '');
        const normalizeBaseUrl = (value) => {
          const raw = trimTrailingSlash(String(value || '').trim());
          if (!raw || raw.includes('%')) return '';
          const withProtocol = /^[a-zA-Z][a-zA-Z\d+.-]*:\/\//.test(raw) ? raw : `http://${raw}`;
          try {
            const parsed = new URL(withProtocol);
            if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return raw;
            return trimTrailingSlash(parsed.toString());
          } catch (_) {
            return raw;
          }
        };
        const readStorage = (key) => {
          try {
            return window.localStorage.getItem(key) || '';
          } catch (_) {
            return '';
          }
        };
        const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        }[char]));
        const readPostText = (post) => (
          post?.translation
          || post?.summary
          || post?.text
          || post?.content
          || post?.title
          || post?.raw_content
          || ''
        );
        const readPostAuthor = (post) => (
          post?.user_screen_name
          || post?.user_name
          || post?.author
          || post?.source
          || '信息流'
        );
        const getPreviewRows = (payload) => {
          const rows = Array.isArray(payload) ? payload : payload?.data;
          return Array.isArray(rows) ? rows.filter(Boolean).slice(0, 4) : [];
        };
        const whenDomReady = () => new Promise((resolve) => {
          if (document.readyState !== 'loading') {
            resolve();
            return;
          }
          document.addEventListener('DOMContentLoaded', resolve, { once: true });
        });
        const removePreviewWhenHydrated = (root, startedAt = Date.now()) => {
          if (!root || !root.isConnected) return;
          if (document.querySelector('.feed-perf-card') || Date.now() - startedAt > 10000) {
            root.remove();
            return;
          }
          window.setTimeout(() => removePreviewWhenHydrated(root, startedAt), 120);
        };
        const renderFeedPreview = async (payload) => {
          const rows = getPreviewRows(payload);
          if (rows.length === 0) return;
          await whenDomReady();
          if (document.querySelector('.feed-perf-card')) return;
          const root = document.getElementById('app-feed-preview');
          if (!root) return;
          const cards = rows.map((post) => `
            <article class="app-feed-preview__card">
              <div class="app-feed-preview__meta">${escapeHtml(readPostAuthor(post))}</div>
              <div class="app-feed-preview__text">${escapeHtml(readPostText(post))}</div>
            </article>
          `).join('');
          root.innerHTML = `
            <div class="app-feed-preview__tabs" aria-hidden="true">
              <span class="app-feed-preview__tab">X</span>
              <span class="app-feed-preview__tab">微博</span>
              <span class="app-feed-preview__tab">B站</span>
              <span class="app-feed-preview__tab">RSS</span>
            </div>
            ${cards}
          `;
          root.hidden = false;
          try {
            window.performance?.mark?.('app-feed-preview-rendered');
          } catch (_) {}
          removePreviewWhenHydrated(root);
        };
        const route = new URL(window.location.href);
        if (route.pathname !== '/') return;
        const source = String(route.searchParams.get('source') || 'x').trim();
        const view = String(route.searchParams.get('view') || '').trim();
        const hasSearch = String(route.searchParams.get('q') || route.searchParams.get('search') || '').trim();
        if (source !== 'x' || view || hasSearch) return;
        const renderBootPreview = route.searchParams.get('__rupb_preview') === '1';

        const params = new URLSearchParams([
          ['page', '1'],
          ['limit', '20'],
          ['final_score', '0'],
          ['sort', 'time_desc'],
          ['group_similar', '1'],
          ['group_threshold', '70'],
          ['source', 'x'],
          ['x_feed_view', 'tracked'],
          ['include_zero_score', 'true'],
        ]);
        const previewParams = new URLSearchParams(params);
        previewParams.set('limit', '4');
        const envBase = normalizeBaseUrl('');
        const storageBase = normalizeBaseUrl(readStorage('api_base_url'));
        const apiBase = storageBase || envBase;
        const apiPath = `/api/v1/post/list?${params.toString()}`;
        const previewApiPath = `/api/v1/post/list?${previewParams.toString()}`;
        const headers = {};
        const apiKey = String(route.searchParams.get('api_key') || readStorage('api_key') || '').trim();
        if (apiKey) headers['X-API-Key'] = apiKey;

        const url = apiBase ? `${apiBase}${apiPath}` : apiPath;
        const previewUrl = apiBase ? `${apiBase}${previewApiPath}` : previewApiPath;
        window[PRELOAD_SLOT] = {
          url,
          startedAt: Date.now(),
          promise: fetch(url, {
            headers,
            credentials: apiBase ? 'omit' : 'same-origin',
          }).then((response) => {
            if (!response.ok) {
              throw new Error(`Default home feed preload failed: ${response.status}`);
            }
            return response.json();
          }).then((data) => ({ data })),
        };
        if (renderBootPreview) {
          let previewRendered = false;
          const renderPreviewOnce = (data) => {
            if (previewRendered) return;
            previewRendered = true;
            void renderFeedPreview(data);
          };
          fetch(previewUrl, {
            headers,
            credentials: apiBase ? 'omit' : 'same-origin',
          })
            .then((response) => {
              if (!response.ok) throw new Error(`Default home feed preview failed: ${response.status}`);
              return response.json();
            })
            .then(renderPreviewOnce)
            .catch(() => {
              window[PRELOAD_SLOT].promise
                .then(({ data }) => renderPreviewOnce(data))
                .catch(() => {});
            });
        }
      })();
    </script>
