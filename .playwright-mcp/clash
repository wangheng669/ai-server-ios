        line-height: 1.4;
      }

      .app-feed-preview {
        position: fixed;
        inset: 0;
        z-index: 20;
        display: flex;
        flex-direction: column;
        gap: 10px;
        overflow: hidden;
        padding: max(14px, env(safe-area-inset-top)) 12px 18px;
        background: #0f172a;
        color: #e5e7eb;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .app-feed-preview[hidden] {
        display: none;
      }

      .app-feed-preview__tabs {
        display: flex;
        gap: 8px;
        overflow: hidden;
        color: #94a3b8;
        font-size: 12px;
        line-height: 1;
        white-space: nowrap;
      }

      .app-feed-preview__tab {
        flex: 0 0 auto;
        border-radius: 999px;
        padding: 7px 10px;
        background: rgba(148, 163, 184, 0.12);
      }

      .app-feed-preview__tab:first-child {
        background: rgba(56, 189, 248, 0.2);
        color: #e0f2fe;
      }

      .app-feed-preview__card {
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 8px;
        padding: 12px;
        background: rgba(15, 23, 42, 0.96);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22);
      }

      .app-feed-preview__meta {
        margin-bottom: 6px;
