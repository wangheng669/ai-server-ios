      if (!homeStartupHrefs.length) return;
      const normalizeRoutePath = () => {
        let path = window.location.pathname || '/';
        const basePath = "/";
        if (basePath !== '/' && path.startsWith(basePath)) {
          path = '/' + path.slice(basePath.length).replace(/^\/+/, '');
        }
        return path.replace(/\/+$/, '') || '/';
      };
      const routePath = normalizeRoutePath();
